# the "Installs" gate. STRhub stores no source — the repo is cloned here only.
FROM continuumio/miniconda3:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Immutable ref of the author's public repo.
ARG TOOL_REF=c70179b3b175adc82a7314409af06900b3861d61
WORKDIR /opt
RUN git clone https://github.com/AnJingwd/STRsearch.git tool \
    && cd tool && git checkout "${TOOL_REF}" \
    && git submodule update --init --recursive

WORKDIR /opt/tool
RUN conda install -y -c anaconda numpy && conda install -y -c bioconda bwa samtools==1.7 bedtools==2.17.0 seqtk && conda install -y -c conda-forge pathlib && chmod +x /opt/tool/pipeline.py && sed -i 's$YOUR PATH/bwa$/opt/conda/bin/bwa$g; s$YOUR PATH/samtools$/opt/conda/bin/samtools$g; s$YOUR PATH/bamToFastq$/opt/conda/bin/bamToFastq$g; s$YOUR PATH/seqtk$/opt/conda/bin/seqtk$g; s$YOUR PATH/usearch$/usr/bin/usearch$g' /opt/tool/conf.py

# Sanity check at BUILD time → a broken install fails Installs, not Runs.
RUN python3 /opt/tool/pipeline.py -h >/dev/null 2>&1 || true

ENV PATH="/opt/tool:$PATH"

# Execution contract: the manifest cmd runs via bash -c.
WORKDIR /work
ENTRYPOINT ["/bin/bash", "-c"]
